KC_URL=https://demo.kommonitor.de/keycloak
KC_REALM_NAME=kommonitor-demo
KC_CLIENT_ID=kommonitor-processor
KC_CLIENT_SECRET=demo.kommonitor.de
KC_TARGET_CLIENT_ID=kommonitor-data-management
# Client the user's offline refresh token is bound to (the frontend/web client that performed
# the offline_access login). Used to refresh stored offline tokens for scheduled runs.
# Public client -> leave the secret empty.
KC_OFFLINE_CLIENT_ID=kommonitor-web-client
KC_OFFLINE_CLIENT_SECRET=
# Service account used by scripts/bootstrap_offline_tokens.py to impersonate users. It must hold
# the realm-management `impersonation` role. Redirect URI must be registered on KC_OFFLINE_CLIENT_ID.
KC_ADMIN_CLIENT_ID=kommonitor-processor
KC_ADMIN_CLIENT_SECRET=demo.kommonitor.de
KC_OFFLINE_REDIRECT_URI=http://localhost:8084/

KOMMONITOR_DATA_MANAGEMENT_URL=https://demo.kommonitor.de/data-management
ALLOWED_ROLES=.client-resources-creator,.unit-resources-creator,kommonitor-creator
PROCESS_RESULTS_DIR=/app/results
# Refresh stored schedule offline tokens before they idle out (interval must be < offlineSessionIdleTimeout).
OFFLINE_TOKEN_REFRESH_ENABLED=True
OFFLINE_TOKEN_REFRESH_CRON="0 3 * * *"