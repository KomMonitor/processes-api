KC_URL=http://keycloak:8080
KC_REALM_NAME=kommonitor
KC_CLIENT_ID=kommonitor-processes-api
KC_CLIENT_SECRET=processes-api-secret
KC_TARGET_CLIENT_ID=kommonitor-data-management

KOMMONITOR_DATA_MANAGEMENT_URL=http://localhost:8085/management
ALLOWED_ROLES=.client-resources-creator,.unit-resources-creator,kommonitor-creator
PROCESS_RESULTS_DIR=/path/to/result/dir
PREFECT_API_URL=http://127.0.0.1:4200/api
PROCESSES_API_URL=http://localhost:8099
PYGEOAPI_CONFIG=demo-config.yml
PREFECT_PAGINATION_ENABLED=True
JOB_STORAGE_DURATION=P30D
JOB_CLEAN_ENABLED=True
JOB_CLEAN_CRON="0 0 * * *"