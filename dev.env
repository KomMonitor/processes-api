KC_URL=https://demo.kommonitor.de/keycloak
KC_REALM_NAME=kommonitor-demo-dev
KC_CLIENT_ID=kommonitor-processor
KC_CLIENT_SECRET=processes-api-secret
KC_TARGET_CLIENT_ID=kommonitor-data-management

KOMMONITOR_DATA_MANAGEMENT_URL=https://demo.kommonitor.de/data-management/management
ALLOWED_ROLES=.client-resources-creator,.unit-resources-creator
PROCESS_RESULTS_DIR=/path/to/result/dir
PREFECT_API_URL=http://127.0.0.1:4200/api
PYGEOAPI_CONFIG=demo-config.yml
PREFECT_PAGINATION_ENABLED=True
JOB_STORAGE_DURATION=P30D
JOB_CLEAN_ENABLED=True
JOB_CLEAN_CRON="0 0 * * *"